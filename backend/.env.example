PORT=5000
JWT_SECRET=your_jwt_secret_key_here
ADMIN_PASSWORD=your_admin_password_here
LIBRARY_PATHS=./movies
DATABASE_PATH=./database/metadata.db
CORS_ORIGIN=*

# Auto-transcode configuration (auto, nvenc, vaapi, cpu)
GPU_ACCEL=auto

# Temporary folders for caching
TRANSCODE_CACHE_DIR=./cache/transcode
POSTER_CACHE_DIR=./cache/posters
SUBTITLE_CACHE_DIR=./cache/subtitles
